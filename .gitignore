.vscode/

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# Environment
.env

# Data — raw snapshot and processed artefacts (large files).
# Contents ignored, but .gitkeep is tracked so the directory structure
# survives a fresh clone (src/ingest.py writes into data/processed/).
data/raw/*
!data/raw/e2e_docs_snapshot/
data/raw/e2e_docs_snapshot/*
!data/raw/e2e_docs_snapshot/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/embedding_runs.jsonl
# Vue history (ADR 0038): only the run log of the archived Vue runs is versioned; it backs the costs in experiment-record-vue.md
!data/processed/archive_vue_2026-10-18/
data/processed/archive_vue_2026-10-18/*
!data/processed/archive_vue_2026-10-18/embedding_runs.jsonl
data/evaluation/scores.csv
data/evaluation/scores_control.csv
data/evaluation/scoring_packet.md
data/evaluation/scoring_items.jsonl

# Chroma vector store
chroma_db/
*.chroma

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Generated / binary docs
*.pdf
!output/figures/*.pdf


# OS
.DS_Store
data/pilot/**/query_embeddings.npz
data/pilot/**/scoring_packet.md
data/pilot/**/scoring_items.jsonl
!data/pilot/**/second_rater/scoring_items.jsonl
data/pilot/**/scores.csv
data/pilot/**/scores_control.csv

# Corpus selection probe: rebuilt pages, probes with section text and source clones (ADR 0038)
data/corpus_probe/docs/
data/corpus_probe/probes/
data/corpus_probe/sources/
data/corpus_probe/questions/*-sections.json
data/pilot/**/output/
