.vscode/

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# Environment
.env

# Data — raw snapshot and processed artefacts (large files).
# Contents ignored, but .gitkeep is tracked so the directory structure
# survives a fresh clone (src/ingest.py writes into data/processed/).
data/raw/*
!data/raw/vue_docs_snapshot/
data/raw/vue_docs_snapshot/*
!data/raw/vue_docs_snapshot/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/evaluation/retrieved_results.csv
data/evaluation/retrieved_results_control.csv
data/evaluation/retrieval_scores.csv
data/evaluation/retrieval_scores_control.csv
data/evaluation/generated_answers.csv
data/evaluation/scores.csv
data/evaluation/query_embeddings.npz

# Chroma vector store
chroma_db/
*.chroma

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Generated / binary docs
*.pdf
!output/figures/*.pdf


# OS
.DS_Store
data/pilot/**/query_embeddings.npz
